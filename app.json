{
  "expo": {
    "name": "Visitra",
    "slug": "visitor-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/v.png",
    "userInterfaceStyle": "light",
    "scheme": "visitor-management",
    "splash": {
      "image": "./assets/v.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visitor.management",
      "infoPlist": {
        "UILaunchStoryboardName": "SplashScreen"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/v.png"
      },
      "package": "com.visitor.management",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/v-removebg-preview.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27932886-4b64-4f75-a2c7-f040fbe4d38a"
      }
    }
  }
}
